<mxfile host="app.diagrams.net">
  <diagram id="state-machine" name="state-machine">
    <mxGraphModel dx="1000" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="400" math="0" shadow="0" background="#161d29">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p" value="[ ] pending" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#8492ac;fontColor=#e8ecf4;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="150" height="44" as="geometry" />
        </mxCell>
        <mxCell id="ip" value="[-] in progress" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#6db3ff;fontColor=#e8ecf4;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="aw" value="[?] awaiting approval" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#b895ff;fontColor=#e8ecf4;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="490" y="90" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="done" value="[x] completed" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#57d9a9;fontColor=#e8ecf4;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="780" y="90" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rev" value="[R] revising" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#f2b35c;fontColor=#e8ecf4;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="490" y="250" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sk" value="[S] skipped" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#8492ac;dashed=1;fontColor=#aab6cc;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="140" y="250" width="160" height="44" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="advance" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="p" target="ip">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t2" value="gate-start" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="ip" target="aw">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t3" value="approve" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="aw" target="done">
          <mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t4" value="reject（Revision Count++）" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0" edge="1" parent="1" source="aw" target="rev">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-56" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t5" value="revise" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=0.75;exitY=0;entryX=0.75;entryY=1" edge="1" parent="1" source="rev" target="aw">
          <mxGeometry relative="1" as="geometry"><mxPoint x="34" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t6" value="skip（jump / スコープ外）" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#9aa7bf;dashed=1;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=0.5;exitY=1;entryX=0.3;entryY=0" edge="1" parent="1" source="p" target="sk">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-30" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="t7" value="auto-advance: 次ステージを [-] に（STAGE_STARTED）" style="edgeStyle=orthogonalEdgeStyle;html=0;strokeColor=#57d9a9;dashed=1;fontColor=#aab6cc;fontSize=11;labelBackgroundColor=#10141d;endArrow=block;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1" edge="1" parent="1" source="done" target="ip">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="350" />
              <mxPoint x="330" y="350" />
            </Array>
            <mxPoint x="0" y="14" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="遷移の実行者はすべて aidlc-state.ts（監査先行 + ディレクトリ mutex）。3 回 reject で Accept as-is が出現" style="text;html=0;fontColor=#aab6cc;fontSize=11;align=left" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="900" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
