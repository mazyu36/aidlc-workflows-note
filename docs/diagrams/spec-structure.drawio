        <mxCell id="lb1" value="Persona-Agents&#10;専門家の協働をモデル化した&#10;マルチエージェント構成の単位" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#6db3ff;fontColor=#e8ecf4;fontSize=12;align=left;spacing=10;verticalAlign=middle" vertex="1" parent="1">
