        </mxCell>
        <mxCell id="c1" value="区画 1 — What&#10;&#10;入力と出力の宣言（宣言的に保つ）&#10;品質が依存する中間成果物も&#10;命令ではなく出力として明示" style="rounded=1;html=0;fillColor=#1e2736;strokeColor=#6db3ff;fontColor=#e8ecf4;fontSize=12;align=left;spacing=12;verticalAlign=middle" vertex="1" parent="1">
